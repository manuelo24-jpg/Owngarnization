# Configuración de Entorno para Owngarnization

# Clave secreta para cookies de sesión (generar una segura en producción)
SECRET_KEY=cambiar-esto-por-una-clave-secreta-larga-y-aleatoria

# Entorno: development | production
ENV=development

# URL de la base de datos
# Local (SQLite por defecto):
DATABASE_URL=sqlite:///./owngarnization.db

# Producción (PostgreSQL en Neon, Render, etc.):
# DATABASE_URL=postgresql://usuario:contraseña@host:port/basededatos?sslmode=require

# Puerto (usado en despliegue)
PORT=8000

# Notificaciones Web Push (VAPID) y Cron de Recordatorios
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@owngarnization.local
CRON_SECRET=cambiar-por-secreto-cron-aleatorio
